{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kazistm/portfolio",
    "type": "project",
    "description": "Personal portfolio of Youcef Nezrek, Full-Stack Software Engineer building modern web applications with Laravel, Vue.js, Inertia.js, and Filament.",
    "keywords": [
        "portfolio",
        "developer-portfolio",
        "software-engineer",
        "fullstack-developer",
        "laravel",
        "php",
        "vuejs",
        "inertiajs",
        "filament",
        "tailwindcss",
        "multilingual",
        "cms",
        "personal-website",
        "web-development",
        "showcase"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.5",
        "inertiajs/inertia-laravel": "^3.1",
        "lara-zeus/spatie-translatable": "^2.0",
        "laravel/framework": "^13.3",
        "laravel/tinker": "^3.0",
        "propaganistas/laravel-phone": "^6.0",
        "spatie/laravel-medialibrary": "^11.21",
        "spatie/laravel-tags": "^4.11",
        "spatie/laravel-translatable": "^6.13",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laradumps/laradumps": "^5.3",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.56",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
